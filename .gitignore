# Python virtual environments
.venv/
.venv-*/
venv/

# FriendlyNode instance-local runtime state
data/config/*
!data/config/.gitkeep
data/import-export/*
!data/import-export/.gitkeep
data/db/*
!data/db/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/identities/*
!data/identities/.gitkeep
data/clients/*
!data/clients/.gitkeep
data/attachments/*
!data/attachments/.gitkeep
data/nomadnet-pages/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# PyCharm / IDE
.idea/
*.iml

# Local Reticulum runtimes and copied upstream sources
runtimes/*/venv/
runtimes/*/src/
runtimes/*/__pycache__/

# OS files
.DS_Store
Thumbs.db

# AI files
AI AGENTS.md
SESSION_HANDOFF.md
